# Copy to .env.local and fill in. Placeholders only — never commit real values.
# Local values for the Supabase variables: `pnpm exec supabase status`.
# Validated at runtime by src/lib/env.ts (server-only).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# HMAC key for rate-limit bucket keys (ADR-0005). At least 32 characters.
# Generate: openssl rand -base64 48
RATE_LIMIT_KEY_SECRET=replace-me-with-at-least-32-random-characters

# The one header trusted for the client IP (ADR-0005). Production: CF-Connecting-IP.
# Leave empty locally: all requests then share one rate-limit bucket.
TRUSTED_IP_HEADER=
